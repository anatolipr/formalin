{
  "name": "vite-svelte-ts-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "js-bridge-mcp": "^0.4.0"
  },
  "scripts": {
    "vite:dev": "vite -c vite.configMain.js -c  vite.config3party.js  --port=4000",
    "build": "rm -rf dist && vite build -c vite.configMain.js && vite build -c vite.configMain2.js && vite build -c vite.configEdit.js && vite build -c vite.config3party.js",
    "preview": "vite preview",
    "dev": "npm run build && cd dist && http-server --cors -p 7877",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.4",
    "avos": "1.0.16",
    "happy-dom": "14.12.0",
    "svelte": "^4.2.17",
    "svelte-check": "^3.7.1",
    "svelte-preprocess": "^6.0.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.11",
    "vite-plugin-css-injected-by-js": "^3.5.1",
    "vitest": "1.6.0"
  }
}
